# Copy this file to .env and fill in real values. Never commit .env.

# From developers.facebook.com -> Your App -> Tools -> Graph API Explorer:
# select your Page from the dropdown, generate a "Page Access Token".
# (A long-lived / System User token is recommended so it doesn't expire
# with your personal login.)
META_PAGE_ACCESS_TOKEN=

# From console.anthropic.com -> API Keys -> Create new key
ANTHROPIC_API_KEY=

# --- Optional (sensible defaults if left blank) ---

# Graph API version to call. Defaults to v21.0.
META_GRAPH_API_VERSION=

# Path to the local SQLite DB file. Defaults to nexoryn_agent.db in the project root.
DB_PATH=

# Log level. Defaults to INFO.
LOG_LEVEL=

# Extra file to also write structured JSON logs to, alongside stdout.
# Defaults to app.log in the project root.
LOG_FILE_PATH=
