# Copy this file to .env and fill in real values. Never commit .env.
# This file doubles as a checklist of everything you need before running the agent.

# --- Meta (Facebook/Instagram) ---
# From Meta App Settings > Basic
META_APP_ID=
META_APP_SECRET=

# From Meta Business Suite / Graph API Explorer (the Page you manage)
META_PAGE_ID=

# Long-lived Page access token. Generate via Graph API Explorer -> exchange
# a short-lived user token for a long-lived page token (System User token
# recommended for production so it doesn't expire with your personal login).
META_PAGE_ACCESS_TOKEN=

# The Instagram professional account ID connected to the Page above.
# Get it via GET /{page-id}?fields=instagram_business_account
META_IG_BUSINESS_ID=

# A random string YOU generate (e.g. `openssl rand -hex 20`). Set this same
# value here AND in the Meta App's Webhooks configuration (Verify Token field).
META_WEBHOOK_VERIFY_TOKEN=

# --- Slack ---
# From Slack App settings > OAuth & Permissions > Bot User OAuth Token (starts xoxb-)
SLACK_BOT_TOKEN=

# From Slack App settings > Basic Information > App-Level Tokens (starts xapp-)
# Required for Socket Mode; needs the `connections:write` scope.
SLACK_APP_TOKEN=

# The channel ID (not name) where approval messages are posted.
# Right-click the channel in Slack -> View channel details -> copy Channel ID.
SLACK_APPROVALS_CHANNEL_ID=

# --- Anthropic ---
# From console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# --- Optional (sensible defaults if left blank) ---
# Graph API version to call. Defaults to v21.0.
META_GRAPH_API_VERSION=

# Path to the local SQLite DB file. Defaults to nexoryn_agent.db in the project root.
DB_PATH=

# Log level for structlog/logging. Defaults to INFO.
LOG_LEVEL=

# Port for the FastAPI webhook server. Defaults to 8000.
PORT=
