# Deploy to /etc/caddy/Caddyfile on the VM (setup_vm.sh does this for you).
#
# A bare domain-name site block is deliberate and sufficient: Caddy's
# defaults already do everything this phase asked for --
#   - binds to :443 with automatic HTTPS
#   - obtains and auto-renews a Let's Encrypt certificate for the domain
#   - implicitly redirects :80 -> :443
# so there's no need to spell any of that out by hand.
#
# /health is not special-cased here: the reverse_proxy below forwards
# every path (including /health) straight to FastAPI, which already
# serves it (see app/main.py) without checking Slack/Meta connectivity --
# exactly what a monitoring probe wants.

agent.nexoryn.tech {
	reverse_proxy localhost:8000

	log {
		output file /var/log/nexoryn-agent/caddy-access.log
	}
}
